# Copy this file to `.env` and add your own Te Papa Collections API key.
# Register for a free key (name + organisation + email):
#   https://data.tepapa.govt.nz/docs/register.html
TEPAPA_API_KEY=

# Optional: LINZ Basemaps API key — enables the "LINZ aerial (NZ)" base layer on
# the maps. Standard access needs no registration; grab a key from
# https://basemaps.linz.govt.nz (note: standard keys expire ~90 days — for the
# public deploy, email basemaps@linz.govt.nz for a non-expiring developer key).
LINZ_API_KEY=

PORT=4000
